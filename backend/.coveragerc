[run]
branch = True
source =
    identity
    system

omit =
    */migrations/*
    */tests/*
    manage.py
    */wsgi.py
    */asgi.py
    */settings.py
    */urls.py
    */__init__.py

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if settings.DEBUG
    if __name__ == .__main__.
    def __str__

[html]
directory = htmlcov

